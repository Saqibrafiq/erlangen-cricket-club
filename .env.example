# Copy to .env.local and fill in. Never commit real secrets.

# PostgreSQL connection string. Local: `pnpm db:up` starts this database via Docker.
DATABASE_URI=postgres://postgres:postgres@localhost:5433/ecc

# Payload encryption secret, at least 32 characters. Generate: `openssl rand -hex 32`
PAYLOAD_SECRET=replace-with-a-random-string-of-at-least-32-chars

# Public canonical origin used for metadata, sitemap and hreflang (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional locally. Required in production for media uploads (Vercel Blob).
BLOB_READ_WRITE_TOKEN=
